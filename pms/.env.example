# Copy to .env (or set these in your hosting environment)
PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
SESSION_HOURS=12
# Scheduled report emails (Phase 8). Without these, reports are produced and kept in the outbox but not sent.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.yourprovider.com:465
EMAIL_FROM=Azeli PMS <reports@azelitech.com>
