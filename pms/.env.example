# Copy to .env (or set these in your hosting environment)
PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
SESSION_HOURS=12
# Scheduled report emails (Phase 8). Without these, reports are produced and kept in the outbox but not sent.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.yourprovider.com:465
EMAIL_FROM=Azeli PMS <reports@azelitech.com>
# WhatsApp Business Platform (Phase 12). Without a token and phone number ID, WhatsApp runs in practice mode on
# test systems and systems with sample data, and is off on a live system.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
# WHATSAPP_API_VERSION=v25.0
