    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Room board", "url": "/#board", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Housekeeping", "url": "/#housekeeping", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reservations", "url": "/#reservations", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "WhatsApp inbox", "url": "/#inbox", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
